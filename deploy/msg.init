#!/bin/sh /etc/rc.common
# procd init script for msg (OpenWrt)

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/msg
CONF=/etc/msg/config.json

start_service() {
	[ -f "$CONF" ] || { echo "missing $CONF"; return 1; }
	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF"
	# Retry forever: the SSD holding the database may mount after boot.
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}
